rule c_COMPILER
  command = cc -MD -MQ $out -MF $DEPFILE -o $out -c $in
  deps = gcc
  depfile = $out.d
  description = Compiling C object $out

rule c_LINKER
  command = cc $in -o $out
  description = Linking C executable $out

build main.o: c_COMPILER src/main.c
  DEPFILE = main.o.d

build hello.o: c_COMPILER src/hello.c
  DEPFILE = hello.o.d

build world.o: c_COMPILER src/world.c
  DEPFILE = world.o.d

build hello: c_LINKER main.o hello.o world.o
