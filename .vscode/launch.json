{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug nixja-gen (example hello)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/src/nixja-gen/nixja-gen",
            "args": ["hello"],
            "cwd": "${workspaceFolder}/example",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
