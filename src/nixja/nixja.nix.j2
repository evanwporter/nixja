				installPhase = ''
					cp "$NIXJA_GEN" "$out"
				'';
			}).outPath
		"out";

	{{target}} =
		pkgs.runCommand "{{ target }}" {
			__contentAddressed = true;
		} ''
			cp -r ${ {{target}}_drv } "$out"
		'';
in
	{{target}}
