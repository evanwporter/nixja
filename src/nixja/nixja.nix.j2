	# nixjaGen = builtins.storePath "@nixjaGen@";
	{{ target }}_drv =
		builtins.outputOf
		(pkgs.stdenvNoCC.mkDerivation
			{
				name = "{{ target }}.drv";

				src = ./.;

				outputHashMode = "text";
				outputHashAlgo = "sha256";

                # TODO: figure out what I need
				nativeBuildInputs = with pkgs; [
